# Majordomo CLI image — static binary at /majordomo for mount/copy into forge jobs.
#
#   docker build -t majordomo -f dockerfiles/Dockerfile.cli .
#   docker create --name md majordomo && docker cp md:/majordomo ./majordomo && docker rm md

FROM golang:1.26.5-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/majordomo ./cmd/majordomo

FROM scratch

COPY --from=build /out/majordomo /majordomo

ENTRYPOINT ["/majordomo"]
